{
  "version": 1,
  "commands": [
    {
      "name": "test-cmd",
      "aliases": ["tc"],
      "keywords": ["comando1"],
      "description": "A test command",
      "tags": ["test"],
      "steps": [{"run": "echo hello"}]
    },
    {
      "name": "test-eval",
      "description": "A test eval command",
      "keywords": ["use_test"],
      "mode": "eval",
      "steps": [{"run": "export TEST=1"}]
    },
    {
      "name": "param-cmd",
      "description": "A parameterized test command",
      "params": [
        {
          "name": "env",
          "default": "staging",
          "choices": ["dev", "staging", "prod"]
        },
        {
          "name": "service",
          "required": true
        },
        {
          "name": "token",
          "required": false,
          "secret": true
        }
      ],
      "steps": [{"run": "echo {{env}} {{service}}"}]
    }
  ]
}
